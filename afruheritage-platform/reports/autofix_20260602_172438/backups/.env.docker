# ── Afruheritage Control Plane ──────────────────────────────────
APP_NAME=Afruheritage Control Plane
APP_ENV=production
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-64-char-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://afruheritage:afruheritage@postgres:5432/afruheritage
POSTGRES_PASSWORD=afruheritage

# ── Celery / Redis ──────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=["https://afruheritage.com","http://frontend:3000","http://admin-console:4000"]

# ── Bootstrap ───────────────────────────────────────────────────
ENABLE_BOOTSTRAP_ADMIN=true

# ── Domain / Runner defaults ────────────────────────────────────
DEFAULT_SUBDOMAIN_BASE=afruheritage.com
RUNNER_DEFAULT_FLEETBASE_ROOT=/srv/afruheritage/tenants
RUNNER_DEFAULT_SSH_PORT=22
RUNNER_DEFAULT_SSH_USER=ubuntu
RUNNER_DEFAULT_SSH_KEY_PATH=./secrets/runner_key

# ── Fleetbase CLI ───────────────────────────────────────────────
FLEETBASE_CLI_PACKAGE=@fleetbase/cli
FLEETBASE_INSTALL_ENVIRONMENT=production
FLEETBASE_DEFAULT_INSTALL_HOST=0.0.0.0
PROVISIONING_TIMEOUT_SECONDS=3600
FLEETBASE_RUNTIME_API_TOKEN=
# Optional global fallback when a tenant-specific runtime token is not configured.

# ── Maps (Mapbox) ────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8100/api/v1/auth/social/google/callback

# TikTok OAuth
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8100/api/v1/auth/social/tiktok/callback

# Geo Provider Settings
GEO_PROVIDER=auto
GEO_TIMEOUT_SECONDS=10
GEO_CACHE_ENABLED=true

# ── Storage ──────────────────────────────────────────────────────
# Leave S3_BUCKET empty to use local filesystem storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
LOCAL_STORAGE_DIR=/srv/afruheritage/storage

# ── Cloudflare (custom domains) ─────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Paystack (billing) ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── GLPI (support ticketing) ───────────────────────────────────
GLPI_BASE_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_TENANT_SEPARATION_MODE=shared_entities

# ── Notifications ────────────────────────────────────────────────
# Choose provider: smtp, sendgrid, ses
EMAIL_PROVIDER=smtp

# SMTP (legacy/backup)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@afruheritage.com
SMTP_FROM_NAME=Afruheritage

# SendGrid
SENDGRID_API_KEY=

# AWS SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SMS Provider: twilio, africastalking
SMS_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Africa's Talking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ── Rate Limiting ───────────────────────────────────────────────
ENABLE_RATE_LIMITING=true
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# ── Structured Logging ───────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true

# ── Docker Specific ───────────────────────────────────────────────
DOCKER_HOST=unix:///var/run/docker.sock
COMPOSE_PROJECT_NAME=afruheritage
