# -----------------------------------------------------------------------
# Afruheritage Control Plane — environment variable reference
# Copy this file to .env and replace ALL placeholder values before use.
# Never commit a .env file containing real secrets.
# -----------------------------------------------------------------------

# --- Application ---
APP_NAME=Afruheritage Control Plane
APP_ENV=production
API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed CORS origins (empty = all blocked)
CORS_ORIGINS=

# Set to false after the first admin account is created
ENABLE_BOOTSTRAP_ADMIN=true

# --- Database ---
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://afruheritage:REPLACE_DB_PASSWORD@postgres:5432/afruheritage

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Runner nodes (default SSH config for provisioning) ---
# IMPORTANT: Inside containers, RUNNER_DEFAULT_SSH_KEY_PATH must point to
# the path where the key is mounted (/run/secrets/afruheritage_runner_key).
# Use HOST_SSH_KEY_PATH to specify the host-side key file for docker-compose volume mount.
RUNNER_DEFAULT_SSH_KEY_PATH=/run/secrets/afruheritage_runner_key
HOST_SSH_KEY_PATH=./secrets/runner_key

RUNNER_DEFAULT_SSH_PORT=22
RUNNER_DEFAULT_SSH_USER=ubuntu
RUNNER_DEFAULT_FLEETBASE_ROOT=/opt/afruheritage/tenants

# --- Fleetbase CLI provisioning ---
FLEETBASE_CLI_PACKAGE=@fleetbase/cli
FLEETBASE_INSTALL_ENVIRONMENT=production
FLEETBASE_DEFAULT_INSTALL_HOST=0.0.0.0
PROVISIONING_TIMEOUT_SECONDS=3600

# --- Domain ---
DEFAULT_SUBDOMAIN_BASE=afruheritage.example.com
