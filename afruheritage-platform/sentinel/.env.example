# ── Admin Console Service ───────────────────────────────────────
ADMIN_APP_NAME=Afruheritage Admin Console
ADMIN_APP_ENV=development
ADMIN_SECRET_KEY=change-me-admin-secret-64-chars
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── Admin Console Database (same Postgres server, separate table) ──
ADMIN_DATABASE_URL=postgresql+psycopg://afruheritage:afruheritage@postgres:5432/afruheritage

# ── Control Plane API (the SaaS backend this console controls) ──
CONTROL_PLANE_BASE_URL=http://api:8000
CONTROL_PLANE_API_PREFIX=/api/v1

# ── CORS ────────────────────────────────────────────────────────
ADMIN_CORS_ORIGINS=["http://localhost:4000"]
