{
  "expo": {
    "name": "Afruheritage Freight",
    "slug": "afruheritage",
    "version": "1.0.0",
    "owner": "tiasefo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afruheritage.freight",
      "infoPlist": {
        "NSCameraUsageDescription": "Required for liveness selfie during KYC verification.",
        "NSPhotoLibraryUsageDescription": "Required to upload ID documents for KYC verification.",
        "NSLocationWhenInUseUsageDescription": "Used to show nearby shipments on the driver dashboard."
      }
    },
    "android": {
      "package": "com.afruheritage.freight",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E67E22",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Required to upload your ID documents for KYC verification.",
          "cameraPermission": "Required for liveness selfie during KYC verification."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ad6a819e-5227-4004-9d0e-39869bf8eb6b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ad6a819e-5227-4004-9d0e-39869bf8eb6b"
    }
  }
}
