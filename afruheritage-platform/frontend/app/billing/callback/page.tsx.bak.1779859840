'use client'

import { Suspense, useEffect, useState } from 'react'
import Link from 'next/link'
import { useSearchParams } from 'next/navigation'
import { billingAPI } from '@/lib/api'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { AlertCircle, ArrowRight, CheckCircle2, Loader2 } from 'lucide-react'

type VerificationState =
  | { status: 'verifying'; message: string }
  | { status: 'success'; message: string; reference: string }
  | { status: 'error'; message: string; reference?: string }

export default function BillingCallbackPage() {
  return (
    <Suspense
      fallback={
        <div className="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-10 sm:px-6 lg:px-8">
          <Card className="w-full max-w-xl">
            <CardContent className="flex items-center gap-3 p-6 text-gray-700">
              <Loader2 className="h-5 w-5 animate-spin" />
              <span>Loading payment details...</span>
            </CardContent>
          </Card>
        </div>
      }
    >
      <BillingCallbackContent />
    </Suspense>
  )
}

function BillingCallbackContent() {
  const searchParams = useSearchParams()
  const [state, setState] = useState<VerificationState>({
    status: 'verifying',
    message: 'Verifying your payment...',
  })

  useEffect(() => {
    const reference = searchParams.get('reference') || searchParams.get('trxref')

    if (!reference) {
      setState({
        status: 'error',
        message: 'We could not find a payment reference in the return URL.',
      })
      return
    }

    let cancelled = false

    const verifyPayment = async () => {
      setState({
        status: 'verifying',
        message: 'Verifying your payment...',
      })

      try {
        const response = await billingAPI.verifyPayment(reference)
        if (cancelled) return

        if (response.status === 'verified') {
          setState({
            status: 'success',
            message: response.message || 'Payment verified successfully.',
            reference,
          })
          return
        }

        setState({
          status: 'error',
          message: response.message || 'Payment was not completed successfully.',
          reference,
        })
      } catch (error: any) {
        if (cancelled) return
        setState({
          status: 'error',
          message: error?.message || 'Payment verification failed. Please try again from the billing page.',
          reference,
        })
      }
    }

    verifyPayment()

    return () => {
      cancelled = true
    }
  }, [searchParams])

  const isSuccess = state.status === 'success'
  const isVerifying = state.status === 'verifying'

  return (
    <div className="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-10 sm:px-6 lg:px-8">
      <Card className="w-full max-w-xl">
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-2xl">
            {isVerifying && <Loader2 className="h-6 w-6 animate-spin" />}
            {isSuccess && <CheckCircle2 className="h-6 w-6 text-green-600" />}
            {state.status === 'error' && <AlertCircle className="h-6 w-6 text-red-600" />}
            Billing Payment Status
          </CardTitle>
        </CardHeader>
        <CardContent className="space-y-6">
          <div
            className={
              isSuccess
                ? 'rounded-lg border border-green-200 bg-green-50 p-4 text-green-800'
                : state.status === 'error'
                  ? 'rounded-lg border border-red-200 bg-red-50 p-4 text-red-800'
                  : 'rounded-lg border border-blue-200 bg-blue-50 p-4 text-blue-800'
            }
          >
            <p className="font-medium">{state.message}</p>
            {'reference' in state && state.reference && (
              <p className="mt-2 text-sm">Reference: {state.reference}</p>
            )}
          </div>

          <div className="flex flex-wrap gap-3">
            <Link href="/billing">
              <Button>
                Return to Billing
                <ArrowRight className="ml-2 h-4 w-4" />
              </Button>
            </Link>
            <Link href="/dashboard">
              <Button variant="outline">Go to Dashboard</Button>
            </Link>
          </div>
        </CardContent>
      </Card>
    </div>
  )
}
