# Frontend Environment Variables for Docker
NODE_ENV=production

# API Configuration — MUST be relative for client-side (browser) requests
# The Next.js rewrite in next.config.mjs proxies /api/v1/* to http://api:8000/api/v1/*
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_URL=http://api:8000
NEXT_PUBLIC_TENANT_ID=amooksco-logistics

# Paystack Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_fb14b11d2b19a3a31df54bf b40008e5986daf55f

# Map Configuration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Application Configuration
NEXT_PUBLIC_APP_URL=https://afruheritage.com
NEXT_PUBLIC_COMPANY_NAME=Afruheritage
NEXT_PUBLIC_SUPPORT_EMAIL=support@afruheritage.com
